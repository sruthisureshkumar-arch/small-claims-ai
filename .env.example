# AI judge: use EITHER provider. Gemini has a free API tier (https://aistudio.google.com/apikey).
GOOGLE_GENERATIVE_AI_API_KEY=
# ANTHROPIC_API_KEY=           # optional: if set, Claude is used instead
# AI_PROVIDER=google           # force "google" or "anthropic"
# JUDGE_MODEL=gemini-3.1-flash-lite # defaults: gemini-3.1-flash-lite, or claude-sonnet-5-5 with Anthropic
# APPEAL_MODEL=                # defaults: same model on Gemini, claude-opus-5-5 with Anthropic

# PayPal sandbox app credentials: https://developer.paypal.com/dashboard/
# Leave blank to run in mock mode (no real PayPal calls).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox

# Public URL of this app (PayPal return/cancel redirects)
APP_URL=http://localhost:3000
